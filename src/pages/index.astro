---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import StatsCounter from '../components/StatsCounter.astro';
import AboutSection from '../components/AboutSection.astro';
import ServiceArea from '../components/ServiceArea.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import ClientsBanner from '../components/ClientsBanner.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="AKS Property Checklist | PROPERTY LEGAL DUE DILIGENCE (Revenue & Legal Areas)"
  description="In house & On Call Experienced Team of Experts for any type of Property Issues (Revenue & Legal). Pan Tamil Nadu service coverage."
>
  <Header />
  <main>
    <Hero />
    <StatsCounter />
    <AboutSection />
    <ServiceArea />
    <ServicesGrid />
    <ClientsBanner />
    <Testimonials />
    <CtaBanner />
  </main>
  <Footer />
</BaseLayout>

