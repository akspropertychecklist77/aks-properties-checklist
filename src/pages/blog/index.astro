---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { blogPosts } from '../../config/blog';
---

<BaseLayout 
  title="Property Insights & Legal Blog | AKS Property Checklist"
  description="Expert articles, legal guides, and property advisory insights on land documentation, Patta mutation, and title protection across Tamil Nadu."
>
  <Header />

  <main class="py-12 md:py-20 bg-slate-50/50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-8">
        <a href="/" class="hover:text-amber-600">Home</a>
        <span>/</span>
        <span class="text-slate-800">Blog</span>
      </nav>

      <!-- Hero Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-block px-3.5 py-1.5 rounded-full bg-amber-100 text-amber-800 text-xs font-extrabold uppercase tracking-wider mb-4">
          Insights &amp; Knowledge
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
          Property Advisory Blog
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-600">
          Educational articles, regulatory updates, and expert checklists to help property owners safeguard their land and investments.
        </p>
        <div class="w-16 h-1 bg-amber-500 mx-auto mt-6 rounded-full"></div>
      </div>

      <!-- Articles Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
        {blogPosts.map(article => (
          <article class="bg-white rounded-3xl p-8 border border-slate-200/80 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-3 py-1 bg-amber-50 text-amber-700 text-xs font-bold rounded-full border border-amber-100">
                  {article.category}
                </span>
                <span class="text-xs text-slate-400 font-medium">{article.readTime}</span>
              </div>

              <h2 class="text-xl font-bold text-slate-900 leading-snug">
                <a href={`/blog/${article.slug}`} class="hover:text-amber-600 transition-colors">
                  {article.title}
                </a>
              </h2>

              <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                {article.excerpt}
              </p>
            </div>

            <div class="mt-8 pt-6 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-amber-100 text-amber-700 font-bold text-xs flex items-center justify-center flex-shrink-0">
                  AKS
                </div>
                <div class="text-xs">
                  <p class="font-bold text-slate-800">{article.author}</p>
                  <p class="text-slate-400">{article.date}</p>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <a 
                  href={`/blog/${article.slug}`}
                  class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold text-white bg-amber-500 hover:bg-amber-600 rounded-full shadow-xs hover:shadow transition-all"
                >
                  <span>Read Article</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>

                <a 
                  href="https://forms.gle/mT9ZcDYSV3GgiWAL6" 
                  data-open-modal
                  data-service={`Blog Enquiry: ${article.title}`}
                  class="px-3 py-2 text-xs font-semibold text-slate-500 hover:text-slate-900 rounded-full hover:bg-slate-100 transition-colors"
                >
                  Discuss
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

    </div>
  </main>

  <CtaBanner />
  <Footer />
</BaseLayout>
