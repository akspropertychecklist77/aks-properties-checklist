---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { blogPosts, type BlogPost } from '../../config/blog';

export async function getStaticPaths() {
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const otherPosts = blogPosts.filter(p => p.slug !== post.slug).slice(0, 2);
---

<BaseLayout 
  title={`${post.title} | AKS Property Checklist Blog`}
  description={post.excerpt}
>
  <!-- SEO BlogPosting Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.title,
    "description": post.excerpt,
    "author": {
      "@type": "Person",
      "name": post.author,
      "jobTitle": post.authorRole
    },
    "publisher": {
      "@type": "Organization",
      "name": "AKS Property Checklist",
      "logo": {
        "@type": "ImageObject",
        "url": "https://akspropertychecklist.in/images/logo.png"
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": `https://akspropertychecklist.in/blog/${post.slug}`
    }
  })} />

  <Header />

  <main class="py-12 md:py-20 bg-[#faf6ee]/50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-500 mb-8">
        <a href="/" class="hover:text-amber-600">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-amber-600">Blog</a>
        <span>/</span>
        <span class="text-slate-800 line-clamp-1">{post.title}</span>
      </nav>

      <!-- Article Header -->
      <header class="bg-white rounded-3xl p-8 sm:p-12 shadow-sm border border-[#ebdcc9] mb-10">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <span class="px-3.5 py-1 bg-amber-100 text-amber-800 text-xs font-black uppercase rounded-full tracking-wider">
            {post.category}
          </span>
          <span class="text-xs font-bold text-slate-400">•</span>
          <span class="text-xs font-bold text-slate-500">{post.readTime}</span>
          <span class="text-xs font-bold text-slate-400">•</span>
          <span class="text-xs font-bold text-slate-500">{post.date}</span>
        </div>

        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
          {post.title}
        </h1>

        <!-- Author Byline -->
        <div class="mt-8 pt-6 border-t border-slate-100 flex items-center gap-4">
          <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-700 font-black text-base flex items-center justify-center flex-shrink-0">
            AKS
          </div>
          <div>
            <p class="font-extrabold text-slate-900 text-sm sm:text-base">{post.author}</p>
            <p class="text-xs font-medium text-slate-500">{post.authorRole} • Verified Property Checklist</p>
          </div>
        </div>
      </header>

      <!-- Article Body -->
      <article class="bg-white rounded-3xl p-8 sm:p-12 shadow-sm border border-[#ebdcc9] space-y-10">
        
        <!-- Intro Lead -->
        <p class="text-base sm:text-lg text-slate-700 font-medium leading-relaxed bg-amber-50/60 p-6 rounded-2xl border border-amber-200/50">
          {post.content.intro}
        </p>

        <!-- Sections -->
        {post.content.sections.map(section => (
          <section class="space-y-4 pt-4 border-t border-slate-100 first:border-0 first:pt-0">
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
              {section.heading}
            </h2>

            {section.paragraphs.map(p => (
              <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
                {p}
              </p>
            ))}

            {section.checklist && (
              <div class="mt-4 p-5 rounded-2xl bg-slate-50 border border-slate-200/80">
                <h3 class="text-xs font-extrabold uppercase tracking-wider text-slate-800 mb-3 flex items-center gap-2">
                  <svg class="w-4 h-4 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  Crucial Document Checklist:
                </h3>
                <ul class="space-y-2">
                  {section.checklist.map(item => (
                    <li class="flex items-start text-xs sm:text-sm text-slate-700 font-medium">
                      <span class="text-amber-500 font-bold mr-2">✓</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {section.tip && (
              <div class="mt-4 p-5 rounded-2xl bg-amber-50/80 border border-amber-200 flex items-start gap-3">
                <span class="text-xl leading-none">💡</span>
                <div>
                  <h4 class="text-xs font-extrabold uppercase tracking-wider text-amber-900 mb-1">Advisory Tip</h4>
                  <p class="text-xs sm:text-sm text-amber-950 font-medium leading-relaxed">{section.tip}</p>
                </div>
              </div>
            )}
          </section>
        ))}

        <!-- Conclusion -->
        <div class="mt-8 pt-8 border-t border-slate-100">
          <h3 class="text-lg font-black text-slate-900 mb-3">Key Takeaway</h3>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-medium">
            {post.content.conclusion}
          </p>
        </div>

        <!-- Consultation Card -->
        <div class="mt-10 p-8 rounded-3xl bg-gradient-to-r from-amber-500 to-amber-600 text-white shadow-lg text-center sm:text-left sm:flex sm:items-center sm:justify-between gap-6">
          <div>
            <h3 class="text-xl font-black">Need assistance with your property?</h3>
            <p class="text-sm text-amber-50 mt-1 max-w-lg">
              Our team conducts 100-year title tracing, Patta rectifications, and field boundary surveys across all 38 districts of Tamil Nadu.
            </p>
          </div>
          <div class="mt-4 sm:mt-0 flex-shrink-0">
            <a 
              href="https://forms.gle/mT9ZcDYSV3GgiWAL6" 
              data-open-modal
              data-service={`Blog Consultation: ${post.title}`}
              class="inline-block px-6 py-3 rounded-full bg-white text-slate-900 font-black text-xs uppercase tracking-wider shadow-md hover:bg-slate-100 transition-all"
            >
              Get Free Assessment
            </a>
          </div>
        </div>

      </article>

      <!-- Back to Blog and Related Articles -->
      <div class="mt-14 space-y-6">
        <div class="flex items-center justify-between">
          <a href="/blog" class="inline-flex items-center gap-2 text-sm font-bold text-amber-600 hover:text-amber-700">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Back to All Articles
          </a>
        </div>

        {otherPosts.length > 0 && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
            {otherPosts.map(other => (
              <a 
                href={`/blog/${other.slug}`}
                class="block bg-white p-6 rounded-2xl border border-[#ebdcc9] hover:border-amber-400 hover:shadow-md transition-all group"
              >
                <span class="text-[11px] font-bold text-amber-700 uppercase tracking-wider">{other.category}</span>
                <h4 class="mt-1 text-base font-bold text-slate-900 group-hover:text-amber-600 transition-colors line-clamp-2">
                  {other.title}
                </h4>
                <p class="mt-2 text-xs text-slate-500 line-clamp-2">{other.excerpt}</p>
                <span class="mt-3 inline-block text-xs font-extrabold text-amber-600">Read Article →</span>
              </a>
            ))}
          </div>
        )}
      </div>

    </div>
  </main>

  <CtaBanner />
  <Footer />
</BaseLayout>
