---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBanner from '../components/CtaBanner.astro';
import RelatedServices from '../components/RelatedServices.astro';
---

<BaseLayout 
  title="Identification of Non – Traceable Properties | AKS Property Checklist"
  description="Locate, physically inspect, and verify ancestral or inherited unidentifiable properties across Tamil Nadu with complete revenue documents."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://akspropertychecklist.in/" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://akspropertychecklist.in/#services" },
      { "@type": "ListItem", "position": 3, "name": "Identification of Non – Traceable Properties", "item": "https://akspropertychecklist.in/identification-of-non-traceable-properties" }
    ]
  })} />

  <Header />
  
  <main class="py-12 md:py-20 bg-[#faf6ee]/60">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs font-bold text-slate-500 mb-8">
        <a href="/" class="hover:text-amber-600">Home</a>
        <span>/</span>
        <a href="/#services" class="hover:text-amber-600">Services</a>
        <span>/</span>
        <span class="text-slate-800">Identification of Non – Traceable Properties</span>
      </nav>

      <!-- Header with 3D Isometric Tile -->
      <div class="bg-white rounded-3xl p-8 sm:p-12 shadow-sm border border-[#ebdcc9] mb-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-8">
            <span class="inline-block px-3.5 py-1.5 rounded-full bg-amber-100 text-amber-800 text-xs font-extrabold uppercase tracking-wider mb-4">
              Tracing Properties
            </span>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
              Identification of Non – Traceable Properties
            </h1>
            <p class="mt-6 text-base sm:text-lg text-slate-600 leading-relaxed">
              This is an essential service for those who inherit properties from parents, in-laws, ancestors, or relatives. Most property owners don’t know where their inherited land is situated or lack complete documentation. Our systematic on-ground and revenue verification process confirms true ownership, physical boundaries, and title legitimacy.
            </p>
            <div class="mt-8">
              <a 
                href="https://forms.gle/mT9ZcDYSV3GgiWAL6" 
                data-open-modal
                data-service="Identification of Non – Traceable Properties"
                class="px-8 py-3.5 text-sm font-extrabold text-white bg-amber-500 hover:bg-amber-600 rounded-full shadow-md hover:shadow-lg transition-all"
              >
                Enquire For Your Property
              </a>
            </div>
          </div>

          <div class="lg:col-span-4 flex justify-center">
            <div class="w-64 h-56 rounded-3xl bg-[#faf6ee] p-4 flex items-center justify-center border border-[#ebdcc9] shadow-lg">
              <img 
                src="/images/service-3d-identification.webp" 
                alt="Identification of Non – Traceable Properties" 
                class="w-full h-full object-contain drop-shadow-xl"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- 3 Methods Breakdown -->
      <div class="space-y-8">
        
        <!-- Section 1: With Documents -->
        <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-sm border border-[#ebdcc9]">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-amber-100 flex items-center justify-center text-amber-600 font-extrabold text-xl">
              1
            </div>
            <h2 class="text-2xl font-bold text-slate-900">Identification With Documents</h2>
          </div>
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 max-w-2xl">
            <h3 class="font-bold text-slate-900 text-lg mb-2">Title Deed</h3>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
              We get the Title Deed from the client &amp; verify it with the Revenue Department Records. This is the Base Document for the ownership of a Property.
            </p>
          </div>
        </div>

        <!-- Section 2: With Location -->
        <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-sm border border-[#ebdcc9]">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-amber-100 flex items-center justify-center text-amber-600 font-extrabold text-xl">
              2
            </div>
            <h2 class="text-2xl font-bold text-slate-900">Identification With Location</h2>
          </div>
          <p class="text-slate-600 text-sm sm:text-base leading-relaxed mb-6">
            Even with just the GPS Longitude &amp; Latitude of the plot, we extract all required essential government records across departmental databases.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100">
              <h3 class="font-bold text-slate-900 text-base sm:text-lg mb-2">1. Geographical Verification</h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                On-site field visits to cross-check the property's physical existence and correlate it with official FMB and cadastral survey maps.
              </p>
            </div>
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100">
              <h3 class="font-bold text-slate-900 text-base sm:text-lg mb-2">2. Survey &amp; Plot Cross-Match</h3>
              <p class="text-sm text-slate-600 leading-relaxed">
                Comparison of the survey number, sub-division, or layout block number mentioned in documents with government revenue registers.
              </p>
            </div>
          </div>
        </div>

        <!-- Section 3: Physical Verification -->
        <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-sm border border-[#ebdcc9]">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-amber-100 flex items-center justify-center text-amber-600 font-extrabold text-xl">
              3
            </div>
            <h2 class="text-2xl font-bold text-slate-900">Physical On-Ground Verification</h2>
          </div>
          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-100 max-w-2xl">
            <h3 class="font-bold text-slate-900 text-lg mb-2">1. Physical Inspection</h3>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
              Confirming physical boundaries, four boundary descriptions, existing fencing, structures, and easements match registered records.
            </p>
          </div>
        </div>

      </div>

      <!-- Bottom CTA Card -->
      <div class="mt-12 bg-amber-500 rounded-3xl p-8 sm:p-10 text-white text-center shadow-xl">
        <h2 class="text-2xl sm:text-3xl font-extrabold">Need Help Locating Your Property?</h2>
        <p class="mt-3 text-amber-100 max-w-xl mx-auto text-sm sm:text-base">
          Send us your deed copy or available survey details. Our team will verify and pinpoint your property across Tamil Nadu.
        </p>
        <a 
          href="https://forms.gle/mT9ZcDYSV3GgiWAL6" 
          data-open-modal
          data-service="Identification of Non – Traceable Properties"
          class="inline-block mt-6 px-8 py-3.5 text-sm font-bold text-slate-900 bg-white hover:bg-amber-50 rounded-full shadow-md transition-all"
        >
          Submit Property Details
        </a>
      </div>

    </div>
  </main>

  <RelatedServices currentHref="/identification-of-non-traceable-properties" />
  <CtaBanner />
  <Footer />
</BaseLayout>
