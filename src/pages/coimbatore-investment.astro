---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import StatsCounter from '../components/StatsCounter.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="Double Your Real-Estate Investment @ Coimbatore | AKS Property Checklist"
  description="Want to double your real estate investment in Coimbatore in record time? Verified, legally clear residential, commercial, and agricultural properties."
>
  <Header />

  <main>
    <!-- Hero / IRB Campaign Section -->
    <section class="relative bg-[#faf6ee] pt-12 pb-20 md:pt-16 md:pb-28 border-b border-[#ebdcc9]/60">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <!-- Left Column: Copy -->
          <div class="lg:col-span-7 space-y-6">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-200/50 text-amber-800 text-xs font-black uppercase tracking-wider border border-amber-300/40">
              Coimbatore Real-Estate Growth Special
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-[1.05]">
              Want to <br />
              <span class="text-amber-500 underline decoration-amber-300 decoration-wavy decoration-2">DOUBLE</span> <br />
              <span class="text-slate-800">your REAL-ESTATE</span> <br />
              <span class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-amber-700">Investment @ Coimbatore</span> <br />
              <span class="text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900">in RECORD TIME?</span>
            </h1>

            <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-xl">
              Coimbatore is rapidly expanding across IT corridors, bypass logistics, and suburban industrial hubs. Secure 100% legally and revenue-cleared properties backed by our forensic title verification.
            </p>

            <div class="pt-4 flex flex-wrap gap-4">
              <a 
                href="https://forms.gle/mT9ZcDYSV3GgiWAL6" 
                data-open-modal
                data-service="Buying & Selling Legally Clear Properties"
                class="px-9 py-4 text-base font-extrabold text-white bg-amber-500 hover:bg-amber-600 active:bg-amber-700 rounded-full shadow-xl hover:shadow-2xl transition-all duration-200 transform hover:-translate-y-1"
              >
                Touch For The Magic — Enquire Now
              </a>
            </div>
          </div>

          <!-- Right Column: Campaign Visual with Golden Door -->
          <div class="lg:col-span-5 flex justify-center">
            <div class="relative w-full max-w-md rounded-3xl overflow-hidden shadow-2xl border-4 border-[#ebdcc9] bg-white group">
              <img 
                src="/images/social-campaign-coimbatore-1080.webp" 
                alt="Double Your Real-Estate Investment in Coimbatore" 
                class="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-105"
                width="1024"
                height="1024"
                loading="eager"
              />
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- C1: Authority & Stats -->
    <StatsCounter />

    <!-- C2: Education (About Property Buying & Approval) -->
    <section class="py-16 md:py-24 bg-white border-b border-slate-100">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
        <div class="text-center max-w-3xl mx-auto">
          <span class="text-xs font-extrabold uppercase tracking-widest text-amber-700 bg-amber-100 px-3 py-1 rounded-full">
            Buyer Education
          </span>
          <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
            About Property Buying &amp; Title Clearance
          </h2>
          <div class="w-16 h-1 bg-amber-500 mx-auto mt-4 rounded-full"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="p-8 rounded-3xl bg-[#faf6ee] border border-[#ebdcc9] space-y-3">
            <h3 class="text-xl font-bold text-slate-900">Why Coimbatore Real Estate?</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              With major infrastructure initiatives like the Avinashi Road Elevated Expressway, Western Ring Road, and defense park corridors, Coimbatore offers stable, high-yield land appreciation when titles are 100% verified.
            </p>
          </div>

          <div class="p-8 rounded-3xl bg-[#faf6ee] border border-[#ebdcc9] space-y-3">
            <h3 class="text-xl font-bold text-slate-900">Zero-Risk Purchase Guarantee</h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              We verify the 100-year Encumbrance Certificate, DTCP/CMDA approvals, computerized patta records, and conduct on-ground DGPS boundary surveys before recommending any parcel.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Grid -->
    <ServicesGrid />

    <!-- Testimonials -->
    <Testimonials />

    <!-- Closing CTA -->
    <CtaBanner />
  </main>

  <Footer />
</BaseLayout>

