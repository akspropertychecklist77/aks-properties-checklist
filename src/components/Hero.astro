r---
---

<section class="relative bg-[#f8efe6] pt-4 pb-12 md:pt-8 md:pb-16 border-b border-[#ebdcc9]/60 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Banner Graphic (Pixel-Perfect from Design) -->
    <div class="relative w-full max-w-5xl mx-auto rounded-3xl overflow-hidden shadow-sm">
      <img 
        src="/images/hero-banner-full.webp" 
        alt="Want to Protect and Double Your Property Value in Record Time - Residential, Commercial, Industrial, Educational, Agricultural" 
        class="w-full h-auto object-contain block"
        width="1024"
        height="484"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <!-- SLIDE 2: PROPERTY LEGAL DUE DILIGENCE (Revenue & Legal Areas) -->
    <!-- Text on the left (small & compact) and image on the right (big & prominent) -->
    <div class="mt-8 sm:mt-12 max-w-6xl mx-auto bg-white rounded-3xl border border-[#ebdcc9] shadow-md overflow-hidden">
      <div class="grid grid-cols-1 md:grid-cols-12 items-center">
        
        <!-- Text on the Left (Spacious & Enhanced Typography) -->
        <div class="md:col-span-5 lg:col-span-5 p-6 sm:p-8 lg:p-9 flex flex-col justify-center text-left">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800 text-[10px] font-black uppercase tracking-wider mb-2.5 self-start">
            <span>Specialized Service</span>
          </div>
          <h2 class="text-xl sm:text-2xl lg:text-[25px] font-black text-slate-900 tracking-tight uppercase leading-snug">
            PROPERTY LEGAL DUE DILIGENCE
            <span class="block text-amber-600 text-xs sm:text-sm lg:text-base font-bold mt-1">(Revenue &amp; Legal Areas)</span>
          </h2>
          <div class="w-10 h-1 bg-amber-500 mt-2.5 mb-4 rounded-full"></div>

          <!-- 3 Pointers with Arrows (Clean & Balanced) -->
          <div class="space-y-2.5 text-slate-800">
            <div class="flex items-center gap-2.5 p-2.5 sm:p-3 rounded-xl bg-[#faf6ee] border border-[#ebdcc9]/80 shadow-2xs">
              <span class="w-5 h-5 rounded-full bg-amber-200 text-amber-800 font-black text-xs flex items-center justify-center flex-shrink-0">→</span>
              <span class="text-xs sm:text-sm font-bold text-slate-900 leading-snug">In house &amp; On Call Experienced Team</span>
            </div>
            <div class="flex items-center gap-2.5 p-2.5 sm:p-3 rounded-xl bg-[#faf6ee] border border-[#ebdcc9]/80 shadow-2xs">
              <span class="w-5 h-5 rounded-full bg-amber-200 text-amber-800 font-black text-xs flex items-center justify-center flex-shrink-0">→</span>
              <span class="text-xs sm:text-sm font-bold text-slate-900 leading-snug">Any type of Property Issues (Revenue &amp; Legal)</span>
            </div>
            <div class="flex items-center gap-2.5 p-2.5 sm:p-3 rounded-xl bg-[#faf6ee] border border-[#ebdcc9]/80 shadow-2xs">
              <span class="w-5 h-5 rounded-full bg-amber-200 text-amber-800 font-black text-xs flex items-center justify-center flex-shrink-0">→</span>
              <span class="text-xs sm:text-sm font-bold text-slate-900 leading-snug">Reliable &amp; Reasonable Services at Finger Tips</span>
            </div>
          </div>
        </div>

        <!-- Image on the Right (Reduced by ~18% for Perfect Balance) -->
        <div class="md:col-span-7 lg:col-span-7 bg-[#d9c4ab] flex items-center justify-center p-4 sm:p-6 lg:p-8 border-t md:border-t-0 md:border-l border-[#ebdcc9]">
          <img 
            src="/images/slide-2-services-board.webp?v=3" 
            alt="Property Legal Due Diligence Services Overview" 
            class="w-full max-w-[85%] sm:max-w-[85%] md:max-w-full h-auto object-contain block drop-shadow-sm transition-transform duration-500 hover:scale-[1.01]"
            width="1024"
            height="768"
            loading="eager"
            fetchpriority="high"
          />
        </div>

      </div>
    </div>

  </div>
</section>
