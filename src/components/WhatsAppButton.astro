---
import { siteConfig } from '../config/site';

interface Props {
  number?: string;
  message?: string;
}

const { 
  number = siteConfig.contact.whatsappNumber,
  message = siteConfig.contact.whatsappMessage 
} = Astro.props;

const whatsappUrl = `https://wa.me/${number}?text=${encodeURIComponent(message)}`;
---

<aside 
  class="fixed bottom-6 right-6 z-50 flex items-center group pointer-events-auto"
  aria-label="Contact AKS Property Checklist via WhatsApp"
>
  <!-- Tooltip Badge (visible on hover) -->
  <a 
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="hidden md:flex items-center gap-2 bg-slate-900/90 text-white text-xs font-bold py-2 px-3.5 rounded-full shadow-xl mr-3 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-x-2 group-hover:translate-x-0 border border-slate-700/60 pointer-events-none group-hover:pointer-events-auto"
  >
    <span class="w-2 h-2 rounded-full bg-[#25D366] animate-pulse"></span>
    <span>Chat with Legal Team</span>
  </a>

  <!-- Floating Button -->
  <a 
    href={whatsappUrl} 
    target="_blank" 
    rel="noopener noreferrer"
    class="relative w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-[#25D366] hover:bg-[#20ba59] active:scale-95 text-white flex items-center justify-center shadow-2xl hover:shadow-[0_10px_25px_rgba(37,211,102,0.5)] transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-[#25D366]/40 group"
    aria-label="Chat on WhatsApp"
  >
    <!-- Subtle Pulse Ring -->
    <span class="absolute inset-0 rounded-full bg-[#25D366] opacity-30 animate-ping pointer-events-none"></span>

    <!-- Official WhatsApp SVG Icon -->
    <svg 
      class="w-7 h-7 sm:w-8 sm:h-8 fill-current drop-shadow-sm transition-transform duration-300 group-hover:scale-110" 
      viewBox="0 0 24 24"
    >
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.77.781 2.796.782 3.185 0 5.77-2.587 5.771-5.766.001-3.181-2.584-5.768-5.771-5.768zm3.376 8.21c-.14.393-.715.734-1.026.782-.28.043-.637.065-1.85-.436-1.551-.641-2.537-2.222-2.614-2.325-.078-.103-.628-.836-.628-1.593 0-.758.396-1.13.536-1.285.14-.155.305-.194.407-.194.102 0 .204.001.293.006.094.004.22-.036.345.263.129.312.44 1.072.478 1.152.039.08.065.174.013.277-.052.103-.078.167-.156.257-.078.09-.163.2-.234.269-.078.077-.16.16-.068.318.092.158.409.674.877 1.091.602.537 1.109.704 1.267.782.158.079.251.066.345-.043.094-.108.402-.468.51-.628.108-.16.216-.134.364-.079.148.055.938.442 1.1.523.161.08.269.12.308.187.039.066.039.384-.101.777zM12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.66 1.434 5.174L2 22l4.981-1.306A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.154c-1.636 0-3.151-.498-4.412-1.353l-.316-.214-2.955.775.789-2.88-.236-.375C3.992 14.802 3.5 13.444 3.5 12c0-4.687 3.813-8.5 8.5-8.5s8.5 3.813 8.5 8.5-3.813 8.5-8.5 8.5z"/>
    </svg>
  </a>
</aside>

