---
import { services } from '../config/services';
---

<section id="services" class="py-16 md:py-24 bg-[#faf6ee] border-b border-[#ebdcc9]/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-extrabold uppercase tracking-widest text-amber-700 bg-amber-200/50 px-3.5 py-1.5 rounded-full border border-amber-300/40">
        Our Core Solutions
      </span>
      <h2 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
        Services
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Professional, transparent, and legally sound services tailored to safeguard your property investments.
      </p>
      <div class="w-16 h-1 bg-amber-500 mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- 6 2-Column Split Service Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {services.map(item => (
        <div class="bg-white rounded-3xl border border-[#ebdcc9] shadow-sm hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 overflow-hidden flex flex-col sm:flex-row group">
          
          <!-- Left: 3D Visual Showcase Panel (Natural fit, no awkward gaps, no inner border box) -->
          <div class="sm:w-5/12 min-h-[220px] sm:min-h-full bg-gradient-to-br from-amber-50/80 via-[#faf6ee] to-amber-100/40 p-6 flex flex-col items-center justify-center relative border-b sm:border-b-0 sm:border-r border-[#ebdcc9]/60">
            <!-- Ambient Backlight Glow -->
            <div class="absolute w-40 h-40 rounded-full bg-amber-300/25 filter blur-xl group-hover:scale-125 transition-transform duration-500 pointer-events-none"></div>
            
            <!-- 3D Isometric Illustration -->
            <a href={item.href} class="relative z-10 w-full flex-1 flex items-center justify-center group-hover:scale-105 transition-transform duration-300">
              <img 
                src={item.image} 
                alt={item.title} 
                class="max-h-44 sm:max-h-52 w-auto object-contain filter drop-shadow-xl"
                loading="lazy"
                width="280"
                height="280"
              />
            </a>

            <!-- Badge Pill -->
            <span class="mt-3 relative z-10 text-[11px] font-extrabold uppercase tracking-wider text-amber-800 bg-amber-200/70 px-3 py-1 rounded-full border border-amber-300/40 shadow-xs">
              {item.badge}
            </span>
          </div>

          <!-- Right: Content & Actions Panel -->
          <div class="sm:w-7/12 p-6 sm:p-7 flex flex-col justify-between">
            <div>
              <!-- Title -->
              <h3 class="text-xl font-extrabold text-slate-900 group-hover:text-amber-600 transition-colors leading-snug">
                <a href={item.href}>{item.title}</a>
              </h3>

              <!-- Description -->
              <p class="mt-3 text-sm text-slate-600 leading-relaxed">
                {item.description}
              </p>

              <!-- Bullet List -->
              <ul class="mt-5 space-y-2 border-t border-slate-100 pt-4">
                {item.bullets.map((bullet, idx) => (
                  idx === 0 ? (
                    <li class="font-extrabold text-xs uppercase tracking-wider text-slate-900 pb-1">
                      {bullet}
                    </li>
                  ) : (
                    <li class="flex items-start text-xs font-semibold text-slate-700">
                      <svg class="w-4 h-4 text-amber-500 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{bullet}</span>
                    </li>
                  )
                ))}
              </ul>
            </div>

            <!-- Actions -->
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between gap-4">
              <a 
                href={item.href} 
                class="text-sm font-bold text-slate-700 hover:text-amber-600 flex items-center gap-1 group-hover:underline"
              >
                Read More
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>

              <a 
                href="https://forms.gle/mT9ZcDYSV3GgiWAL6" 
                data-open-modal
                data-service={item.title}
                class="px-5 py-2 text-xs font-bold uppercase tracking-wider text-white bg-amber-500 hover:bg-amber-600 active:bg-amber-700 rounded-full shadow-sm hover:shadow transition-all"
              >
                Enquiry
              </a>
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
